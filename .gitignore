# Never commit real secrets — only the .example template.
.profile.secret
shell/.profile.secret
**/.profile.secret
pi/.pi/agent/auth.json
pi/.pi/agent/models-store.json
pi/.pi/agent/sessions/

# pi-fabric runtime state (project-scoped mesh/actors) — machine-local
.pi/fabric/

# pi-subagents run artifacts (written to cwd by the subagent tool)
.pi-subagents/

# Backup files produced by install.sh's link_path
*.bak.*

# OS cruft
.DS_Store
