# Copy to ~/.profile.secret (same dir as $HOME, NOT inside the repo) and fill
# in real values. ~/.profile sources this at the end; it is never committed.
# Keep the real file mode 600.

export BASETEN_API_KEY=""

# Pre-registered OAuth clients for MCP servers that do not support dynamic
# client registration. Both use http://localhost:19876/callback.
# One Google "Desktop app" OAuth client is shared by Gmail, Calendar, and Drive.
export GOOGLE_MCP_OAUTH_CLIENT_ID=""
export GOOGLE_MCP_OAUTH_CLIENT_SECRET=""

# Slack app credentials (Basic Information > App Credentials). Configure the
# redirect URL and User Token Scopes documented in README.md.
export SLACK_MCP_OAUTH_CLIENT_ID=""
export SLACK_MCP_OAUTH_CLIENT_SECRET=""
