#!/usr/bin/env bash
# Start (idempotently) a Waterworks node bound to this machine's tailnet IP and
# join any ww node already running on the same tailnet. Erlang distribution and
# epmd listen ONLY on the tailscale address, so nodes can only reach each other
# over the tailnet. Secrets are never created here: put the shared cookie in
# ~/.erlang.cookie (0400) and a per-node WW_ADMIN_TOKEN in ~/.profile.secret.
# shortcut: joins the first peer found, so start nodes one at a time (two fresh
# nodes started at once form separate clusters); upgrade to a seed list if needed.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
die() { echo "ww-up: $*" >&2; exit 1; }

[ -f "$HOME/.profile.secret" ] && { set -a; . "$HOME/.profile.secret"; set +a; }
[ -f "$HOME/.erlang.cookie" ] || die "missing ~/.erlang.cookie (copy the shared cookie, mode 0400)"
[ "${#WW_ADMIN_TOKEN}" -ge 16 ] || die "WW_ADMIN_TOKEN (>=16 chars) not set in ~/.profile.secret"
command -v ww >/dev/null && command -v erl >/dev/null || die "ww/erl not installed (run dotfiles install.sh)"

ip="$(tailscale ip -4 2>/dev/null | head -1)"
[ -n "$ip" ] || die "not on a tailnet (tailscale ip -4 failed)"
name="ww-${WW_HOST:-$(hostname -s)}@$ip"
log="$HOME/.local/state/waterworks/ww.log"
mkdir -p "$(dirname "$log")"

# macOS: run under launchd (foreground ww, KeepAlive) instead of nohup. The agent
# re-invokes this script with WW_FOREGROUND=1.
if [ "$(uname -s)" = Darwin ] && [ -z "${WW_FOREGROUND:-}" ]; then
  plist="$HOME/Library/LaunchAgents/dev.shalin.ww.plist"
  mkdir -p "$(dirname "$log")"
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.shalin.ww</string>
<key>ProgramArguments</key><array><string>$HOME/.local/bin/ww-up</string></array>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
<key>WW_HOST</key><string>${WW_HOST:-mbp}</string><key>WW_FOREGROUND</key><string>1</string>
</dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>$log</string>
<key>StandardErrorPath</key><string>$log</string>
</dict></plist>
PLIST
  launchctl bootout "gui/$(id -u)/dev.shalin.ww" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "ww-up: launchd agent dev.shalin.ww loaded"; exit 0
fi

export ERL_EPMD_ADDRESS="$ip,127.0.0.1" # loopback keeps local `epmd -names` working
epmd -daemon -address "$ip,127.0.0.1"

# Already running? epmd (bound to our tailnet IP) lists registered node names.
if [ -z "${WW_FOREGROUND:-}" ] && epmd -names 2>/dev/null | grep -q "name ww-${WW_HOST:-$(hostname -s)} "; then
  echo "ww-up: $name already running"; exit 0
fi

IFS=. read -r a b c d <<<"$ip"
export ERL_AFLAGS="-kernel inet_dist_use_interface {$a,$b,$c,$d} inet_dist_listen_min 9100 inet_dist_listen_max 9109"

# Find a ww node (registered as ww-*) on another online tailnet peer.
join=""
# Only probe our own devices (same tailnet user): the tailnet has hundreds of peers.
for peer in $(tailscale status --json | jq -r '.Self.UserID as $u | .Peer[]? | select(.Online and .UserID == $u) | .TailscaleIPs[0]'); do
  n="$(timeout 4 erl -noshell -eval '
    case erl_epmd:names(hd(init:get_plain_arguments())) of
      {ok, L} -> [io:format("~s~n", [N]) || {N, _} <- L, lists:prefix("ww-", N)];
      _ -> ok end, halt().' -extra "$peer" 2>/dev/null | grep -m1 -E "^ww-[A-Za-z0-9_-]+$" || true)"
  [ -n "$n" ] && { join="$n@$peer"; break; }
done

echo "ww-up: starting $name${join:+ joining $join}"
export WW_JOIN="$join"
# WW_FOREGROUND=1 (launchd) keeps ww in the foreground so the supervisor restarts it.
[ -n "${WW_FOREGROUND:-}" ] && exec ww serve --name "$name"
nohup ww serve --name "$name" >>"$log" 2>&1 &
